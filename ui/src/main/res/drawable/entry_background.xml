<?xml version="1.0" encoding="utf-8"?>
<!-- An entry of a panel or a list (the settings panels, Pictures): framed in the accent color
     while it has focus, like a tile. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/entry_focused" />
            <stroke
                android:width="@dimen/entry_frame"
                android:color="@color/accent" />
            <corners android:radius="@dimen/entry_corner" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
