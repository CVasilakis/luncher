<?xml version="1.0" encoding="utf-8"?>
<!-- A floating panel going, a tile's menu too: a short fade, so it never just disappears, and is
     gone before the next key could tell. Nothing waits for it: what closed it acts as it starts
     fading. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="80"
    android:fromAlpha="1"
    android:interpolator="@android:interpolator/linear"
    android:toAlpha="0" />
