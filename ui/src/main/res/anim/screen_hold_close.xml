<?xml version="1.0" encoding="utf-8"?>
<!-- The screen under a full-screen screen that closes (Animation.Luncher.Screen): it is back as it
     was, while the one closing fades out over it, for as long as that takes (anim/panel_exit's). -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="80"
    android:fromAlpha="1"
    android:toAlpha="1" />
