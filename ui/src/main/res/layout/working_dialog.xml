<?xml version="1.0" encoding="utf-8"?>
<!-- WorkingDialog: a spinning wheel and a message beside it; below them Cancel, a button, for work
     that can be stopped, gone otherwise. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="@dimen/working_padding">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.luncher.launcher.ui.ThemedSpinner
            android:id="@+id/working_spinner"
            android:layout_width="@dimen/working_spinner"
            android:layout_height="@dimen/working_spinner"
            android:indeterminate="true" />

        <com.luncher.launcher.ui.ThemedText
            android:id="@+id/working_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/working_gap"
            android:maxWidth="@dimen/working_text_width"
            android:textSize="@dimen/working_text" />
    </LinearLayout>

    <com.luncher.launcher.ui.PillButton
        android:id="@+id/working_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/working_entry_gap"
        android:ellipsize="end"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="sans-serif-medium"
        android:minHeight="@dimen/button_height"
        android:paddingLeft="@dimen/button_padding"
        android:paddingRight="@dimen/button_padding"
        android:singleLine="true"
        android:textSize="@dimen/text_button"
        android:visibility="gone"
        app:kind="tonal" />
</LinearLayout>
