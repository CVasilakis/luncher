<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Every background colour Android may show for a screen is set here, dark, rather than
         left to Theme.DeviceDefault, which device makers may restyle: never a white screen,
         ThemesTest checks it. windowSplashScreenBackground is the splash screen's from
         Android 12 on, which on TV is only that colour. -->
    <style name="Theme.Luncher" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <!-- No starting window up to Android 11: the previous screen stays until the home screen
             draws, as it does from Android 12 on (ui/README.md#while-luncher-starts). -->
        <item name="android:windowDisablePreview">true</item>
        <!-- Texts line up at the start of their view, the left on the home screen, which stays
             left to right, and the right in a mirrored one, whatever their own direction.
             Otherwise each would follow its own: an Arabic arrange title at the right, against
             the hint, or English entries at the left of a mirrored settings panel. -->
        <item name="android:textAlignment">viewStart</item>
    </style>

    <!-- A dialog over a screen of the menus and settings (Dialogs.kt: a question, a message, a
         menu, a new name): a floating panel like the settings panel, over the dimmed screen. -->
    <style name="Theme.Luncher.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/panel_background</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:textAlignment">viewStart</item>
        <!-- The dialog theme's minimum width is a share of the screen; the layout sets the width. -->
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <!-- Never Android's dialog animation, which is slower (PanelDialog). -->
        <item name="android:windowAnimationStyle">@style/Animation.Luncher.Panel</item>
    </style>

    <!-- How a floating panel comes and goes: a short fade in (anim/panel_enter) and out
         (anim/panel_exit), in place of Android's slower dialog and activity animations. The
         window's items for a dialog's window or a list's (a PopupWindow); the activity's for an
         activity (the settings panel), whose window plays only its activity's opening and closing:
         a dialog theme has none, so Android's played, the panel popping in and out on Android 16. -->
    <style name="Animation.Luncher.Panel" parent="">
        <item name="android:windowEnterAnimation">@anim/panel_enter</item>
        <item name="android:windowExitAnimation">@anim/panel_exit</item>
        <item name="android:activityOpenEnterAnimation">@anim/panel_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/panel_exit</item>
    </style>
    <!-- How a full-screen screen (the appearance editor, the background editor, Add from folder,
         the tile banner picker) comes and goes: the same short fade, whole screens too, in place of
         Android's cross-fade of about 350 ms; the screen under it holds still meanwhile. Set in
         those screens' themes, never in Theme.Luncher's, which is also the home screen's: how the
         home screen opens an app and comes back from one stays Android's. -->
    <style name="Animation.Luncher.Screen" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/panel_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_hold_open</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_hold_close</item>
        <item name="android:activityCloseExitAnimation">@anim/panel_exit</item>
    </style>

    <!-- Android 5.1 and 6.0 play no app dialog's window entrance: there the dialog plays it in its
         window (PanelDialog, WindowEntrance), and the window only fades as it goes. An entrance
         that changes nothing, so a device that would play one doesn't play it twice; not @null,
         with which Android 5.1 played no exit either for a dialog that dims the screen. -->
    <style name="Animation.Luncher.Panel.ExitOnly">
        <item name="android:windowEnterAnimation">@anim/panel_none</item>
    </style>

    <!-- WorkingDialog: a floating panel as the dialogs are. -->
    <style name="Theme.Luncher.Working" parent="@style/Theme.Luncher.Dialog" />

    <!-- A button of the menus and settings (PillButton): as wide as EntriesRow gives it, or its
         layout, its text on one line, its icon before it. -->
    <style name="Widget.Luncher.Button" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingLeft">@dimen/button_padding</item>
        <item name="android:paddingRight">@dimen/button_padding</item>
        <item name="android:drawablePadding">@dimen/icon_gap</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_button</item>
    </style>
</resources>
