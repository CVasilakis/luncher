<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The themed views' (Themed.kt): Material for TV's sizes, on Android TV's 960 x 540 dp
         canvas. The type: a screen's title (smaller on a screen less than 450 dp tall, 720p at
         the 1080p density; values-h450dp has every other screen's), a panel's or a dialog's, an
         entry's text, a line below it or a hint, a section's label above a list, a button's. -->
    <dimen name="text_display">28sp</dimen>
    <dimen name="text_title">28sp</dimen>
    <dimen name="text_dialog_title">24sp</dimen>
    <dimen name="text_entry">18sp</dimen>
    <dimen name="text_supporting">14sp</dimen>
    <dimen name="text_label">14sp</dimen>
    <dimen name="text_button">16sp</dimen>
    <!-- Corners: an entry's, a field's; a panel's and a dialog's; a picture's. A button and a
         chip have round ends. -->
    <dimen name="corner_entry">12dp</dimen>
    <dimen name="corner_panel">28dp</dimen>
    <dimen name="corner_picture">8dp</dimen>
    <!-- A list's container (ScrollFrame, an option's list): its corners; an entry's in it,
         concentric with them: the container's less the 10 dp it leaves around its entries
         (settings_container_padding, settings_option_list_padding), so the two curves run side
         by side. An entry far from a container's corners (in a side sheet, a dialog) keeps
         corner_entry. -->
    <dimen name="corner_container">20dp</dimen>
    <dimen name="corner_entry_in_container">10dp</dimen>
    <!-- How much a focused field grows (a little, as Material for TV's list items: a scale, so a
         wide one grows more; a list's rows don't), and a button (less than
         Material for TV's 1.1: Luncher's buttons are wide, two side by side a gap apart), and how
         high a button is lifted, for its shadow (an entry isn't: entries sit close, and its shadow
         would fall on the next). -->
    <item name="entry_zoom" format="float" type="dimen">1.03</item>
    <item name="button_zoom" format="float" type="dimen">1.06</item>
    <dimen name="button_lift">4dp</dimen>
    <!-- A button: its height at least, its padding at the sides, the gap after its icon. An
         icon's size; a small one, beside a line of text. -->
    <dimen name="button_height">48dp</dimen>
    <dimen name="button_padding">24dp</dimen>
    <dimen name="icon_gap">8dp</dimen>
    <dimen name="icon">24dp</dimen>
    <dimen name="icon_small">18dp</dimen>
    <!-- An outlined button's edge (Delete all, Reset to defaults); an open field's (ListEntry). -->
    <dimen name="outline">1.5dp</dimen>
    <dimen name="open_field_edge">2dp</dimen>
    <!-- An entry of the menus and settings: its padding at the sides, the gap after its icon; a
         row of a list or a menu (Hide apps, a picture's actions), as tall as an entry at least;
         the gap between entries one below the other; between buttons side by side (EntriesRow).
         Between a panel's title and its first entry (smaller on a screen less than 450 dp tall,
         720p at the 1080p density; values-h450dp has every other screen's). -->
    <dimen name="entry_padding">16dp</dimen>
    <dimen name="entry_icon_gap">16dp</dimen>
    <dimen name="row_height">52dp</dimen>
    <dimen name="entry_gap">4dp</dimen>
    <dimen name="buttons_gap">16dp</dimen>
    <dimen name="title_gap">10dp</dimen>
    <!-- A dialog (Dialogs.kt, and the window after a share, which looks like one): its width at
         most, its padding, its margin from the screen's edges at least; its mark (Badge), the
         icon's padding in it, the gap to the title; the gap below the title, its text's size, the
         gap above the buttons; the name field's padding above and below its text, its edge. -->
    <dimen name="dialog_width">460dp</dimen>
    <dimen name="dialog_padding">28dp</dimen>
    <dimen name="dialog_margin">32dp</dimen>
    <dimen name="badge">40dp</dimen>
    <dimen name="badge_padding">9dp</dimen>
    <dimen name="badge_gap">16dp</dimen>
    <dimen name="dialog_text_gap">12dp</dimen>
    <dimen name="dialog_text">16sp</dimen>
    <dimen name="dialog_buttons_gap">28dp</dimen>
    <dimen name="name_field_padding_vertical">12dp</dimen>
    <dimen name="name_field_edge">2dp</dimen>
    <!-- A scrolling list's fade into its container, at an end with more beyond it (ScrollFrame);
         less than a row, which the focus keeps away from the end. -->
    <dimen name="scroll_fade">40dp</dimen>
    <!-- A panel's corners; the focus frame of an entry in it (entry_background). -->
    <dimen name="panel_corner">12dp</dimen>
    <!-- WorkingDialog: the panel's padding, its spinning wheel and the gap to the message, the
         message's size and width at most; the gap above its Cancel. -->
    <dimen name="working_padding">28dp</dimen>
    <dimen name="working_spinner">40dp</dimen>
    <dimen name="working_gap">20dp</dimen>
    <dimen name="working_text">18sp</dimen>
    <dimen name="working_text_width">400dp</dimen>
    <dimen name="working_entry_gap">28dp</dimen>
    <!-- How far the edge around what's drawn on the wallpaper reaches past the shape
         (WallpaperOutline). The home screen's gear (feature/home's home_settings.xml) draws twice
         this, in its own units. -->
    <dimen name="wallpaper_outline">0.75dp</dimen>
    <!-- The home screen's padding at the sides, its top bar's and its tiles' (feature/home's
         home_activity.xml): Android TV's overscan margin, plus room for the focused tile's zoom.
         Here, as what shows a home tile elsewhere sizes it from it too (homeTileSize). -->
    <dimen name="screen_padding_horizontal">48dp</dimen>
    <!-- How far the band around a see-through picture's shape reaches past it, the frame a focus
         that follows the shape is drawn with, and how far its soft shadow spreads (TileShapes). -->
    <dimen name="tile_shape_band">2.5dp</dimen>
    <dimen name="tile_shape_shadow">7dp</dimen>
    <!-- The app's name below the focused tile (TileName), and the gap between the two, both before
         the tile's zoom, which they're drawn with: the home screen's, and the room the appearance
         editor's preview leaves it. -->
    <dimen name="tile_name_text">16sp</dimen>
    <dimen name="tile_name_gap">8dp</dimen>
</resources>
