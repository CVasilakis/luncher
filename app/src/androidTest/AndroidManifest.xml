<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Another app's pictures, as a gallery shares them: the test package's own provider, in its
         own process, serving the sample files in assets/pictures/ (SamplePictures). Exported, as
         the app under test reads it without a grant (the tests send the share from its process). -->
    <application>
        <provider
            android:name="com.luncher.launcher.testing.SamplePictures"
            android:authorities="${applicationId}.samples"
            android:exported="true" />
        <!-- Another app's pictures that only a grant opens, as a gallery's (GrantedPictures): not
             exported, so a share must give, and Luncher pass on, the access to read them. -->
        <provider
            android:name="com.luncher.launcher.testing.GrantedPictures"
            android:authorities="${applicationId}.granted"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Another app's screen sending a share (ShareSender), as a gallery does. Exported: the
             tests start it from the app's process. -->
        <activity
            android:name="com.luncher.launcher.testing.ShareSender"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Another app whose picture never comes (StalledPictures): it opens a stream it never
             sends on, or never answers the open. Exported, as SamplePictures. -->
        <provider
            android:name="com.luncher.launcher.testing.StalledPictures"
            android:authorities="${applicationId}.stalled"
            android:exported="true" />
    </application>

</manifest>
