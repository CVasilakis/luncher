<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android TV's overscan margin, plus room for the focused tile's zoom. -->
    <dimen name="home_padding_horizontal">48dp</dimen>
    <dimen name="home_padding_vertical">32dp</dimen>
    <!-- Between the top bar and the tiles; room for a focused tile's zoom in the first row. -->
    <dimen name="home_tiles_padding_top">24dp</dimen>
    <!-- Between tiles; more than a tile grows when it zooms, so neighbors never overlap. -->
    <dimen name="home_tile_gap">24dp</dimen>
    <!-- About how wide a tile is: as many fit in a row as make the nearest whole number, so a
         16:9 TV's 960 dp, less its padding, has five. Fewer on a narrower screen, more on a wider
         one or at a lower density. -->
    <dimen name="home_tile_width">154dp</dimen>
    <dimen name="home_tile_frame">3dp</dimen>
    <dimen name="home_time_text">32sp</dimen>
    <dimen name="home_date_text">18sp</dimen>
    <!-- Between the time and the date. -->
    <dimen name="home_clock_gap">16dp</dimen>
    <!-- The settings entry at the end of the top bar: its size, and the gear's inset within it. -->
    <dimen name="home_settings_size">40dp</dimen>
    <dimen name="home_settings_padding">8dp</dimen>
    <!-- Arrange mode: the key hint at the end of the top bar; the shelf's label, and its empty
         slot's dashed outline and caption. -->
    <dimen name="home_arrange_hint_text">18sp</dimen>
    <dimen name="home_shelf_label_text">18sp</dimen>
    <dimen name="home_shelf_slot_line">2dp</dimen>
    <dimen name="home_shelf_slot_dash">8dp</dimen>
    <dimen name="home_shelf_caption_text">14sp</dimen>
    <dimen name="home_shelf_caption_padding">12dp</dimen>

    <dimen name="settings_panel_width">420dp</dimen>
    <dimen name="settings_panel_padding">24dp</dimen>
    <dimen name="settings_panel_corner">12dp</dimen>
    <dimen name="settings_title_text">24sp</dimen>
    <!-- Between the title and the first entry. -->
    <dimen name="settings_title_gap">16dp</dimen>
    <dimen name="settings_entry_height">56dp</dimen>
    <dimen name="settings_entry_padding">16dp</dimen>
    <dimen name="settings_entry_text">20sp</dimen>
    <dimen name="settings_entry_frame">3dp</dimen>
    <dimen name="settings_entry_corner">8dp</dimen>
    <!-- Between two groups of entries. -->
    <dimen name="settings_group_gap">16dp</dimen>
    <!-- The Hide apps list: at most six and a half rows tall, then it scrolls; the half row shows
         there's more. On a small screen fewer, so the panel keeps the margin from the screen's
         top and bottom edges. Between an app's name and its state. -->
    <dimen name="settings_list_max_height">364dp</dimen>
    <dimen name="settings_panel_margin">32dp</dimen>
    <dimen name="settings_app_state_gap">16dp</dimen>
    <!-- The strip at the list's end, in the panel's padding, where its scrollbar goes. -->
    <dimen name="settings_list_scrollbar">12dp</dimen>
    <dimen name="settings_list_scrollbar_negative">-12dp</dimen>
</resources>
