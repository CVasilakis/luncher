<?xml version="1.0" encoding="utf-8"?>
<!-- One entry of the settings panel; OK on it does what the entry is for. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/settings_entry_height"
    android:background="@drawable/settings_entry_background"
    android:ellipsize="end"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/settings_entry_padding"
    android:paddingRight="@dimen/settings_entry_padding"
    android:singleLine="true"
    android:textColor="@color/text_primary"
    android:textSize="@dimen/settings_entry_text" />
