<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the window's content FrameLayout: one view level less to lay out and draw. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The top bar stays in place; the tiles scroll in the space below it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The clock at the start; what follows it in the bar sits at the end (the settings
             entry, later e.g. status indicators). Not focusable itself: D-pad Up from the tiles
             reaches only what's focusable in it. While the user arranges apps, the mode's title
             and key hint take the place of the clock and the settings entry. -->
        <LinearLayout
            android:id="@+id/home_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/home_padding_horizontal"
            android:paddingTop="@dimen/home_padding_vertical"
            android:paddingRight="@dimen/home_padding_horizontal">

            <!-- Time and date share a baseline (LinearLayout's default). -->
            <com.luncher.launcher.home.ClockView
                android:id="@+id/home_clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/home_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_time_text" />

                <TextView
                    android:id="@+id/home_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/home_clock_gap"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/home_date_text" />
            </com.luncher.launcher.home.ClockView>

            <!-- As tall as the settings entry it replaces, so the tiles below stay where they are. -->
            <TextView
                android:id="@+id/home_arrange_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="@dimen/home_settings_size"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/home_arrange_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/home_time_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_arrange_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/home_arrange_hint_text"
                android:visibility="gone" />

            <!-- Opens the settings panel. Focusable, so Up from the first row of tiles reaches it. -->
            <ImageView
                android:id="@+id/home_settings"
                android:layout_width="@dimen/home_settings_size"
                android:layout_height="@dimen/home_settings_size"
                android:background="@drawable/home_settings_background"
                android:contentDescription="@string/home_settings"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/home_settings_padding"
                android:src="@drawable/home_settings" />
        </LinearLayout>

        <!-- Tiles may zoom past the padding, and scroll through it up to the top bar. -->
        <com.luncher.launcher.home.AppTilesView
            android:id="@+id/home_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/home_padding_horizontal"
            android:paddingTop="@dimen/home_tiles_padding_top"
            android:paddingRight="@dimen/home_padding_horizontal"
            android:paddingBottom="@dimen/home_padding_vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/home_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/home_no_apps"
        android:textColor="@color/text_secondary"
        android:textSize="20sp"
        android:visibility="gone" />

</merge>
