<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- As the app declares it, so the JVM tests, which have no app manifest, follow a
         right-to-left language as the app does. -->
    <application android:supportsRtl="true">

        <!-- How the home screen behaves; what makes it the device's home screen and a TV app (its
             intent filters) is the app's to declare, in its manifest, which the build merges with
             this one. adjustNothing: the keyboard the rename dialog opens doesn't slide the home
             screen up behind it to keep the focused tile in sight; the dialog moves instead
             (NameDialog). -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Luncher"
            android:windowSoftInputMode="adjustNothing" />
    </application>

</manifest>
