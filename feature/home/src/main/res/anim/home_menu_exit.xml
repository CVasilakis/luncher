<?xml version="1.0" encoding="utf-8"?>
<!-- A tile's menu, going: a short fade, so it never just disappears, and is gone before the next
     key could tell. The same on every side. Nothing waits for it: an entry's action starts as the
     menu starts fading. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/linear">
    <alpha
        android:duration="80"
        android:fromAlpha="1"
        android:toAlpha="0" />
</set>
