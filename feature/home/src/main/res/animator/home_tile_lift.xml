<?xml version="1.0" encoding="utf-8"?>
<!-- Lifts an app tile while it has focus, with the focus frame off: the framed tile's zoom
     (home_tile_focus.xml), and a rise toward the viewer, as high as :ui's tile_lift, which makes
     Android's renderer cast the tile's shadow, from its outline. Declared once per tile, so a key
     press starts existing animators instead of creating new ones. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- OK held: the tile dips a little at once, and comes down to half its lift, so the press
         shows before the app or the menu opens; back in the focused item's time once it ends. As
         home_tile_focus.xml's dip. -->
    <item android:state_pressed="true" android:state_focused="true">
        <set>
            <objectAnimator
                android:duration="80"
                android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="scaleX"
                android:valueTo="1.1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="80"
                android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="scaleY"
                android:valueTo="1.1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="80"
                android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="translationZ"
                android:valueTo="@dimen/tile_lift_pressed"
                android:valueType="floatType" />
        </set>
    </item>
    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:duration="@android:integer/config_shortAnimTime"
                android:propertyName="scaleX"
                android:valueTo="1.15"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@android:integer/config_shortAnimTime"
                android:propertyName="scaleY"
                android:valueTo="1.15"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@android:integer/config_shortAnimTime"
                android:propertyName="translationZ"
                android:valueTo="@dimen/tile_lift"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="@android:integer/config_shortAnimTime"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@android:integer/config_shortAnimTime"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@android:integer/config_shortAnimTime"
                android:propertyName="translationZ"
                android:valueTo="0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
