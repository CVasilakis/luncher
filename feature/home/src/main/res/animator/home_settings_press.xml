<?xml version="1.0" encoding="utf-8"?>
<!-- The settings gear in the top bar, while OK is held on it: it dips (the gear and its focused
     disc) at once, so the press shows before the panel opens; back in the focus animators' time once
     it ends. As the tiles' dip (home_tile_focus.xml). Declared once, with the view, so a key press
     starts existing animators instead of creating new ones. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="80"
                android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="scaleX"
                android:valueTo="0.88"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="80"
                android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="scaleY"
                android:valueTo="0.88"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="@android:integer/config_shortAnimTime"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@android:integer/config_shortAnimTime"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
