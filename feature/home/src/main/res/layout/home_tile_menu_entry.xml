<?xml version="1.0" encoding="utf-8"?>
<!-- An entry of a tile's menu, its icon before it: OK on it does what it says to the tile's app.
     A row of the menu's list, so it's as tall as the list makes its rows where they scroll. -->
<com.luncher.launcher.ui.ListEntry xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/home_menu_entry_height"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/home_menu_entry_padding"
    android:paddingRight="@dimen/home_menu_entry_padding"
    app:entryCorner="@dimen/home_menu_entry_corner">

    <com.luncher.launcher.ui.ThemedIcon
        android:id="@+id/home_tile_menu_icon"
        android:layout_width="@dimen/icon"
        android:layout_height="@dimen/icon"
        android:duplicateParentState="true"
        android:importantForAccessibility="no" />

    <com.luncher.launcher.ui.ThemedText
        android:id="@+id/home_tile_menu_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/home_menu_icon_gap"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="@dimen/text_entry" />
</com.luncher.launcher.ui.ListEntry>
