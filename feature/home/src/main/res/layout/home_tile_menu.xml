<?xml version="1.0" encoding="utf-8"?>
<!-- A tile's menu: its entries, one below the other, which TileMenu adds. As wide as the longest
     entry, and at least home_menu_width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_tile_menu"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/home_menu_width"
    android:orientation="vertical"
    android:padding="@dimen/home_menu_padding" />
