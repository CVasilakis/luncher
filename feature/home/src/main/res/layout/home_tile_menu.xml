<?xml version="1.0" encoding="utf-8"?>
<!-- A tile's menu: the app's name, then its entries, one below the other, which TileMenu adds. As
     wide as the longest entry, and at least home_menu_width. A margin around the entries, which
     their corners follow (TileMenu). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:minWidth="@dimen/home_menu_width"
    android:orientation="vertical"
    android:padding="@dimen/home_menu_padding">

    <com.luncher.launcher.ui.ThemedText
        android:id="@+id/home_tile_menu_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:paddingLeft="@dimen/home_menu_entry_padding"
        android:paddingTop="@dimen/home_menu_title_padding_top"
        android:paddingRight="@dimen/home_menu_entry_padding"
        android:paddingBottom="@dimen/home_menu_title_padding_bottom"
        android:singleLine="true"
        android:textSize="@dimen/text_label"
        app:colorRole="onSurfaceVariant" />

    <LinearLayout
        android:id="@+id/home_tile_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical" />
</LinearLayout>
