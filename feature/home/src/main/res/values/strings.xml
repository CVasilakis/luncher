<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen's texts. Each translation, in values-<language>/, has every string here. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Shown in place of the tiles when the device has no TV apps. -->
    <string name="home_no_apps">No TV apps installed</string>
    <!-- Shown in place of the tiles when every app is hidden. The settings panel's title and its
         Hide apps entry, as the panel shows them. -->
    <string name="home_all_hidden">All apps are hidden. Open <xliff:g id="settings" example="Settings">%1$s</xliff:g> → <xliff:g id="hide_apps" example="Hide apps">%2$s</xliff:g> to show them again.</string>
    <!-- The gear at the end of the top bar, for screen readers: it opens the settings panel. -->
    <string name="home_settings">Settings</string>
    <!-- The menu a long press of OK on an app's tile opens, over the home screen: what the user
         can do to that app. Move: move its tile to another place on the home screen. -->
    <string name="home_menu_move">Move</string>
    <!-- Hide: take the app off the home screen at once (Settings → Hide apps shows it again). -->
    <string name="home_menu_hide">Hide</string>
    <!-- App info: open the app's page in the device's settings (its storage, permissions, force
         stop, uninstall), as Android's own "App info". Dimmed where the device has no such page. -->
    <string name="home_menu_info">App info</string>
    <!-- A message, when App info was chosen but the device's settings no longer open the app's page. -->
    <string name="home_menu_info_unavailable">App info isn\'t available on this device</string>
    <!-- While the user moves an app chosen in that menu: the top bar's title, and which keys do
         what. OK and Back are the remote's buttons; the arrows are its D-pad, and stay as they
         are. The D-pad moves the app; OK, or Back, puts it down where it is. -->
    <string name="home_move_title">Move app</string>
    <string name="home_move_hint"><xliff:g id="arrows" example="↑↓←→">↑↓←→</xliff:g> Move · OK Done</string>
    <!-- While the wallpaper is drawn again, in a window over the home screen, which waits for it:
         the TV's screen changed size (it switched to 4K, say), so the wallpaper is drawn for it. -->
    <string name="home_wallpaper_screen_changed">Fitting the background to this screen…</string>
    <!-- The same, when the wallpaper kept is outdated: Luncher was updated, or it's lost. -->
    <string name="home_wallpaper_outdated">Updating the background…</string>
    <!-- The same, while a new wallpaper saved in the background editor is drawn, which the user
         left before it was done: as that editor says it (settings_background_applying). -->
    <string name="home_wallpaper_saving">Processing background…</string>
</resources>
