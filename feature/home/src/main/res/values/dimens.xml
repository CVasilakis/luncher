<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android TV's overscan margin, plus room for the focused tile's zoom; at the sides, :ui's
         screen_padding_horizontal, which what shows a home tile elsewhere sizes it from too. -->
    <dimen name="home_padding_vertical">32dp</dimen>
    <!-- Between the top bar and the tiles; room for a focused tile's zoom in the first row. -->
    <dimen name="home_tiles_padding_top">24dp</dimen>
    <!-- How high a lifted tile rises while it has focus: the size and softness of its shadow. -->
    <dimen name="home_tile_lift">12dp</dimen>
    <dimen name="home_time_text">32sp</dimen>
    <dimen name="home_date_text">18sp</dimen>
    <!-- The message in place of the tiles: no TV apps installed, or all of them hidden. -->
    <dimen name="home_empty_text">20sp</dimen>
    <!-- Between the time and the date. -->
    <dimen name="home_clock_gap">16dp</dimen>
    <!-- The settings entry at the end of the top bar: its size, and the gear's inset within it. -->
    <dimen name="home_settings_size">40dp</dimen>
    <dimen name="home_settings_padding">8dp</dimen>
    <!-- Moving an app: the key hint at the end of the top bar. -->
    <dimen name="home_move_hint_text">18sp</dimen>
    <!-- A tile's menu: its least width, its padding around the entries, an entry's height, its
         corners (concentric with the menu's, a panel's here, :ui's corner_panel, less the padding;
         TileMenu makes both follow the tiles') and inner padding, the gap after an entry's icon, and the
         gap between the menu and the tile, zoomed, and its name. -->
    <dimen name="home_menu_width">220dp</dimen>
    <dimen name="home_menu_padding">10dp</dimen>
    <dimen name="home_menu_entry_height">52dp</dimen>
    <dimen name="home_menu_entry_corner">18dp</dimen>
    <!-- The least of them in a menu with round corners, which otherwise get a third of the
         menu's where concentric ones would be nearly square (TileMenu.entryCorner). -->
    <dimen name="home_menu_entry_corner_least">2dp</dimen>
    <dimen name="home_menu_entry_padding">16dp</dimen>
    <dimen name="home_menu_icon_gap">16dp</dimen>
    <dimen name="home_menu_gap">12dp</dimen>
</resources>
