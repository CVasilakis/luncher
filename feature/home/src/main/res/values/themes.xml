<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The home screen's window while the settings panel is over it (HomeActivity): Android's
         animations, as the Home key can bring it back then too, but for the one that closes the panel. -->
    <style name="Animation.Luncher.Home.UnderPanel" parent="@android:style/Animation.Activity">
        <item name="android:activityCloseExitAnimation">@anim/panel_exit</item>
    </style>

    <!-- A tile's menu (TileMenu): a small floating panel like the settings panel, over the home
         screen, which isn't dimmed, so the tile it's for stays as it is. -->
    <style name="Theme.Luncher.Home.Menu" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/panel_background</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:textAlignment">viewStart</item>
        <!-- The dialog theme's minimum width is a share of the screen; the layout sets the width. -->
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <!-- Never Android's dialog animation, which is slower: TileMenu.placeAt sets the one of
             the side the menu is on as it opens; this is the most common one. -->
        <item name="android:windowAnimationStyle">@style/Animation.Luncher.Home.Menu.Above</item>
    </style>

    <!-- A tile's menu comes out of its tile, from the side it's on (anim/home_menu_enter_*), and
         fades as it goes; TileMenu.placeAt chooses one as the menu opens. -->
    <style name="Animation.Luncher.Home.Menu" parent="">
        <item name="android:windowExitAnimation">@anim/panel_exit</item>
    </style>
    <style name="Animation.Luncher.Home.Menu.Above">
        <item name="android:windowEnterAnimation">@anim/home_menu_enter_above</item>
    </style>
    <style name="Animation.Luncher.Home.Menu.Below">
        <item name="android:windowEnterAnimation">@anim/home_menu_enter_below</item>
    </style>
    <style name="Animation.Luncher.Home.Menu.Left">
        <item name="android:windowEnterAnimation">@anim/home_menu_enter_left</item>
    </style>
    <style name="Animation.Luncher.Home.Menu.Right">
        <item name="android:windowEnterAnimation">@anim/home_menu_enter_right</item>
    </style>
    <!-- Android 5.1 and 6.0 play no app dialog's window entrance: there the menu plays it in its
         window (TileMenu's WindowEntrance), and the window only fades as it goes. No entrance
         here, so a device that would play one doesn't play it twice. -->
    <style name="Animation.Luncher.Home.Menu.ExitOnly">
        <item name="android:windowEnterAnimation">@null</item>
    </style>
</resources>
