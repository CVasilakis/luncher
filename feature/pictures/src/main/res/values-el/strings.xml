    <string name="pictures_unsupported">Αυτή η τηλεόραση δεν μπορεί να δείξει εικόνες <xliff:g id="format" example="HEIF (HEIC)">%1$s</xliff:g>. Αποθηκεύστε την ως JPEG ή PNG και προσθέστε εκείνη.</string>
    <plurals name="pictures_too_large">
        <item quantity="one">Είναι πολύ μεγάλη: μια εικόνα μπορεί να έχει έως <xliff:g id="size" example="50 MB">%1$s</xliff:g> και <xliff:g id="megapixels" example="1">%2$d</xliff:g> megapixel.</item>
        <item quantity="other">Είναι πολύ μεγάλη: μια εικόνα μπορεί να έχει έως <xliff:g id="size" example="50 MB">%1$s</xliff:g> και <xliff:g id="megapixels" example="64">%2$d</xliff:g> megapixel.</item>
    </plurals>
    <string name="pictures_unreadable">Το Luncher δεν μπορεί να τη διαβάσει. Αντιγράψτε την στον φάκελο <xliff:g id="folder" example="Android/media/com.luncher.launcher">%1$s</xliff:g> στην τηλεόραση ή σε ένα USB και μετά επιλέξτε Προσθήκη από φάκελο.</string>
