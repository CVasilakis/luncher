<?xml version="1.0" encoding="utf-8"?>
<!-- Add from folder: the title and where the pictures are, then the list of them, and beside it a
     preview of the selected one with what OK does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/pictures_margin_horizontal"
    android:paddingTop="@dimen/pictures_margin_vertical"
    android:paddingRight="@dimen/pictures_margin_horizontal"
    android:paddingBottom="@dimen/pictures_margin_vertical">

    <TextView
        android:id="@+id/pictures_folder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/pictures_add_from_folder"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/pictures_title_text" />

    <TextView
        android:id="@+id/pictures_folder_where"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pictures_tile_text_gap"
        android:layout_marginBottom="@dimen/pictures_title_gap"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/pictures_status_text" />

    <!-- The list, and the preview's column at its end. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/pictures_side_width">

            <!-- A pictures_folder_row per picture; selected, framed like a focused entry. -->
            <ListView
                android:id="@+id/pictures_folder_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:listSelector="@drawable/entry_background"
                android:scrollbarStyle="outsideOverlay" />

            <!-- Looking for them, or none there. -->
            <TextView
                android:id="@+id/pictures_folder_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/pictures_text" />
        </FrameLayout>

        <!-- The preview at most this size, smaller on a short screen, so the note fits below it. -->
        <com.luncher.launcher.pictures.PreviewColumn
            android:id="@+id/pictures_folder_side"
            android:layout_width="@dimen/pictures_preview_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical">

            <!-- Drawn at exactly its size, as the picture fills a 16:9 screen; PreviewColumn sets
                 it. -->
            <ImageView
                android:id="@+id/pictures_folder_preview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/pictures_thumbnail_background"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/pictures_folder_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pictures_tile_text_gap"
                android:text="@string/pictures_folder_note"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/pictures_small_text" />
        </com.luncher.launcher.pictures.PreviewColumn>
    </FrameLayout>
</LinearLayout>
