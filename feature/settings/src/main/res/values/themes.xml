<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The settings panel: a floating window over the dimmed home screen. -->
    <style name="Theme.Luncher.Settings" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/panel_background</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/panel</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <!-- As in Theme.Luncher: in a right-to-left language every text lines up at the right,
             an English one too. -->
        <item name="android:textAlignment">viewStart</item>
        <!-- The dialog theme's minimum width is a share of the screen; the layout sets the width. -->
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>

    <!-- A panel the settings panel opens in its place (Hide apps): the settings panel's window
         stays behind it, invisible, and already dims the home screen. -->
    <style name="Theme.Luncher.Settings.Panel">
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- The appearance editor: full-screen and opaque, unlike the panels, so the home screen
         behind it is stopped, and applies a change once, when it comes back. -->
    <style name="Theme.Luncher.Settings.FullScreen" parent="@style/Theme.Luncher">
        <item name="android:windowBackground">@color/panel</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/panel</item>
    </style>

    <!-- Pictures and Add from folder: full-screen, on the home screen's background. -->
    <style name="Theme.Luncher.Settings.Pictures" parent="@style/Theme.Luncher" />

    <!-- A dialog over Pictures (a picture's actions, a confirmation, a message): a floating panel
         like the settings panel, over the dimmed screen. -->
    <style name="Theme.Luncher.Settings.Pictures.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/panel_background</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:textAlignment">viewStart</item>
        <!-- The dialog theme's minimum width is a share of the screen; the layout sets the width. -->
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>

    <!-- SharePictureActivity: no window, as Theme.NoDisplay, but the home screen's dark
         backgrounds, in case a device shows one anyway (never a white screen, ThemesTest). It
         finishes before onResume, as a windowNoDisplay activity must. -->
    <style name="Theme.Luncher.Settings.Pictures.NoDisplay">
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
