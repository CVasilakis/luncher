<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The settings panels as a side sheet (Sheet.kt): its width, its margin from the screen's
         edges, its padding; the margin around the rows, inside the list (the room their zoom
         needed when they had one). The margin and the
         padding above and below, and the gaps marked "short" below, are smaller here, on a screen
         less than 450 dp tall (720p at the 1080p density), so the settings panel's entries fit it;
         values-h450dp has them for every other screen. -->
    <dimen name="settings_sheet_width">360dp</dimen>
    <dimen name="settings_sheet_margin">16dp</dimen>
    <dimen name="settings_sheet_padding_horizontal">14dp</dimen>
    <dimen name="settings_sheet_padding_top">20dp</dimen>
    <dimen name="settings_sheet_padding_bottom">16dp</dimen>
    <dimen name="settings_zoom_room_horizontal">10dp</dimen>
    <dimen name="settings_zoom_room_vertical">4dp</dimen>
    <!-- Hide apps' "No apps" below the hint: below the empty list's margin above and below its
         rows, where it has always been (2 x settings_zoom_room_vertical). -->
    <dimen name="settings_hide_apps_empty_top">8dp</dimen>
    <!-- An entry (its padding at the sides, the gap after its icon, a row's height and the gap
         between entries are ui's): its height at least, its padding above and below (short),
         between its title and its line below; the gap between an app's name and its
         "Hidden". -->
    <dimen name="settings_entry_min_height">56dp</dimen>
    <dimen name="settings_entry_padding_vertical">6dp</dimen>
    <dimen name="settings_entry_line_gap">2dp</dimen>
    <dimen name="settings_app_state_gap">16dp</dimen>
    <!-- Above and below an app's two names in Hide apps: its own, and the one the user gave it. -->
    <dimen name="settings_app_names_margin">8dp</dimen>

    <!-- A chip (Chip.kt): its height at least (more with large text), its padding at the sides. A
         stepped option's: its padding beside its arrows, the gaps inside it, the accent's swatch,
         the value's size; the padding at the option's end, before its chip. -->
    <dimen name="settings_chip_height">28dp</dimen>
    <dimen name="settings_chip_padding">12dp</dimen>
    <dimen name="settings_chip_padding_arrow">6dp</dimen>
    <dimen name="settings_chip_gap">6dp</dimen>
    <dimen name="settings_swatch">14dp</dimen>
    <dimen name="text_chip">16sp</dimen>
    <dimen name="settings_entry_padding_end_chip">8dp</dimen>

    <!-- A screen of its own (the editors, Add from folder): its content inside the TV's overscan
         margin; between its columns, and below the preview; below its title; a list's
         container's padding, room for its focused entry's zoom too; the margin and the gap
         between the columns, less that room, which a column's content keeps inside it; a
         section's label above its content, the gap between them; the preview's corners. -->
    <dimen name="settings_appearance_margin_horizontal">48dp</dimen>
    <dimen name="settings_appearance_margin_vertical">32dp</dimen>
    <dimen name="settings_screen_gap">20dp</dimen>
    <dimen name="settings_screen_title_gap">20dp</dimen>
    <dimen name="settings_container_padding">10dp</dimen>
    <dimen name="settings_screen_margin_less_room">38dp</dimen>
    <dimen name="settings_screen_gap_less_room">10dp</dimen>
    <dimen name="settings_label_gap">12dp</dimen>
    <dimen name="settings_preview_corner">16dp</dimen>
    <!-- The tile banner picker's preview: the room around the focused tile, zoomed, in its panel,
         for its frame, its band or its shadow (TilePreviewView). -->
    <dimen name="settings_tile_preview_room">16dp</dimen>

    <!-- The appearance editor: the groups' container at most this wide, and half the screen on a
         narrow one; an option set in from its group, level with the group's name (the group's
         padding, icon and its gap); the gap between an option's name and its value. -->
    <dimen name="settings_appearance_options_width">440dp</dimen>
    <dimen name="settings_appearance_option_indent">56dp</dimen>
    <dimen name="settings_appearance_value_gap">8dp</dimen>

    <!-- The picture editors (the background editor): their fields, their height at least, their
         padding at the end, their label's size and their value's, the gap between them; a
         picture's row, its padding above and below; its thumbnail, 16:9, the size the thumbnails
         are drawn at; the hairline around a see-through picture's thumbnail. -->
    <dimen name="settings_field_height">56dp</dimen>
    <dimen name="settings_field_padding_end">12dp</dimen>
    <dimen name="text_field_label">13sp</dimen>
    <dimen name="text_field_value">17sp</dimen>
    <dimen name="settings_fields_gap">12dp</dimen>
    <dimen name="settings_pictures_row_padding">8dp</dimen>
    <dimen name="settings_pictures_thumbnail_width">80dp</dimen>
    <dimen name="settings_pictures_thumbnail_height">45dp</dimen>
    <dimen name="settings_pictures_thumbnail_line">1dp</dimen>

    <!-- An option's values in a list beside its field (OptionList): its padding around the
         entries, which their corners follow; its least width, its gap to the field, its shadow,
         its corners; an entry's height. -->
    <dimen name="settings_option_list_padding">10dp</dimen>
    <dimen name="settings_option_list_min_width">200dp</dimen>
    <dimen name="settings_option_list_gap">16dp</dimen>
    <dimen name="settings_option_list_elevation">16dp</dimen>
    <dimen name="settings_option_list_corner">20dp</dimen>
    <dimen name="settings_option_list_entry_height">48dp</dimen>

    <!-- Add from folder: its content inside the TV's overscan margin; where the pictures are, below
         the title, and the selected one's name below its preview; below the title and that line;
         between a picture and its text, a thumbnail's corners; a row of the list at least; the gap
         between the list and the preview's column; the warning mark in place of a preview that
         can't be drawn. The margin above and below and the gap below the title are short, so the
         list shows more than two rows below 450 dp tall. -->
    <dimen name="settings_pictures_margin_horizontal">48dp</dimen>
    <dimen name="settings_pictures_margin_vertical">20dp</dimen>
    <dimen name="settings_pictures_where_text">16sp</dimen>
    <dimen name="settings_pictures_title_gap">16dp</dimen>
    <dimen name="settings_pictures_tile_text_gap">8dp</dimen>
    <dimen name="settings_pictures_tile_corner">8dp</dimen>
    <dimen name="settings_pictures_row_height">64dp</dimen>
    <!-- The least height of Add from folder's preview: shorter than a row of the list, it goes,
         with its label and name. -->
    <dimen name="settings_pictures_preview_least">64dp</dimen>
    <dimen name="settings_pictures_side_gap">32dp</dimen>
    <dimen name="settings_pictures_warning">48dp</dimen>

    <!-- The window after a share (its other sizes are ui's dialog_…): its spinning wheel while the
         picture is added. -->
    <dimen name="settings_received_spinner">32dp</dimen>
</resources>
