<?xml version="1.0" encoding="utf-8"?>
<!-- The settings panels' texts. Each translation, in values-<language>/, has every string here. -->
<resources>
    <!-- The settings panel's title. -->
    <string name="settings_title">Settings</string>
    <!-- The entry that opens the list of apps to hide or show, and that list's title. -->
    <string name="settings_hide_apps">Hide apps</string>
    <!-- After an app's name in that list, while the app is hidden. -->
    <string name="settings_hidden">Hidden</string>
    <!-- Shown in that list when the device has no TV apps. -->
    <string name="settings_no_apps">No TV apps installed</string>
    <!-- The entry that opens the device's own settings. -->
    <string name="settings_system">System settings</string>
    <!-- A message, when the device has no settings app to open. -->
    <string name="settings_system_unavailable">This device has no settings app</string>
</resources>
