<?xml version="1.0" encoding="utf-8"?>
<!-- One entry of the settings panel: its icon, its name, centered in the height, and at its end
     where it goes (a panel of its own, another app). OK on it does what the entry is for. -->
<com.luncher.launcher.ui.ListEntry xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_entry_min_height"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/settings_entry_padding"
    android:paddingTop="@dimen/settings_entry_padding_vertical"
    android:paddingRight="@dimen/settings_entry_padding"
    android:paddingBottom="@dimen/settings_entry_padding_vertical">

    <com.luncher.launcher.ui.ThemedIcon
        android:id="@+id/settings_entry_icon"
        android:layout_width="@dimen/icon"
        android:layout_height="@dimen/icon"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        app:colorRole="onSurfaceVariant" />

    <com.luncher.launcher.ui.ThemedText
        android:id="@+id/settings_entry_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_entry_icon_gap"
        android:layout_marginEnd="@dimen/settings_entry_icon_gap"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="@dimen/text_entry" />

    <com.luncher.launcher.ui.ThemedIcon
        android:id="@+id/settings_entry_end"
        android:layout_width="@dimen/icon"
        android:layout_height="@dimen/icon"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        app:colorRole="onSurfaceVariant" />
</com.luncher.launcher.ui.ListEntry>
