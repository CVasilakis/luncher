<?xml version="1.0" encoding="utf-8"?>
<!-- The Hide apps list: a side sheet like the settings panel, in its place (Sheet.kt): its title,
     what OK does, then the apps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_hide_apps_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_sheet_padding_horizontal"
    android:paddingTop="@dimen/settings_sheet_padding_top"
    android:paddingEnd="@dimen/settings_sheet_padding_horizontal"
    android:paddingBottom="@dimen/settings_sheet_padding_bottom">

    <com.luncher.launcher.ui.ThemedText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_zoom_room_horizontal"
        android:layout_marginEnd="@dimen/settings_zoom_room_horizontal"
        android:includeFontPadding="false"
        android:text="@string/settings_hide_apps"
        android:textSize="@dimen/text_title" />

    <com.luncher.launcher.ui.ThemedText xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_zoom_room_horizontal"
        android:layout_marginTop="@dimen/settings_entry_line_gap"
        android:layout_marginEnd="@dimen/settings_zoom_room_horizontal"
        android:layout_marginBottom="@dimen/title_gap"
        android:text="@string/settings_hide_apps_hint"
        android:textSize="@dimen/text_supporting"
        app:colorRole="onSurfaceVariant" />

    <!-- A settings_app_row per app, filling the sheet down to its padding: it fades out where
         there's more and scrolls a row ahead of the selection. Rows are recycled while scrolling;
         the selected one is the focused entry. A margin inside around them. Without apps, a text
         over the empty list says so. -->
    <com.luncher.launcher.ui.ScrollFrame
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.luncher.launcher.ui.LookAheadListView
            android:id="@+id/settings_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="@dimen/entry_gap"
            android:listSelector="@android:color/transparent"
            android:paddingLeft="@dimen/settings_zoom_room_horizontal"
            android:paddingTop="@dimen/settings_zoom_room_vertical"
            android:paddingRight="@dimen/settings_zoom_room_horizontal"
            android:paddingBottom="@dimen/settings_zoom_room_vertical"
            android:scrollbars="none" />

        <com.luncher.launcher.ui.ThemedText xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/settings_no_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/settings_zoom_room_horizontal"
            android:layout_marginTop="@dimen/settings_hide_apps_empty_top"
            android:text="@string/settings_no_apps"
            android:textSize="@dimen/text_entry"
            android:visibility="gone"
            app:colorRole="onSurfaceVariant" />
    </com.luncher.launcher.ui.ScrollFrame>
</LinearLayout>
