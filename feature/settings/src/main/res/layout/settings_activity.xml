<?xml version="1.0" encoding="utf-8"?>
<!-- The panel: a floating window as wide as this view, and as tall as its entries. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/settings_panel_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/settings_panel_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_title_gap"
        android:includeFontPadding="false"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_title_text" />

    <!-- SettingsActivity adds a settings_entry for each entry of settingsMenu, a gap between groups. -->
    <LinearLayout
        android:id="@+id/settings_entries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
