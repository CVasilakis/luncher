<?xml version="1.0" encoding="utf-8"?>
<!-- The settings panel: a side sheet on the home screen's gear's side (Sheet.kt), its title, then its entries,
     which scroll on a screen too short for them all. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_sheet_padding_horizontal"
    android:paddingTop="@dimen/settings_sheet_padding_top"
    android:paddingEnd="@dimen/settings_sheet_padding_horizontal"
    android:paddingBottom="@dimen/settings_sheet_padding_bottom">

    <com.luncher.launcher.ui.ThemedText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_zoom_room_horizontal"
        android:layout_marginEnd="@dimen/settings_zoom_room_horizontal"
        android:layout_marginBottom="@dimen/title_gap"
        android:includeFontPadding="false"
        android:text="@string/settings_title"
        android:textSize="@dimen/text_title" />

    <!-- SettingsActivity adds a settings_entry for each entry of settingsMenu, in order; they
         scroll a row ahead of the focus, on a screen too short for them, fading out where there's
         more. A margin inside around them. -->
    <com.luncher.launcher.ui.ScrollFrame
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.luncher.launcher.ui.LookAheadScrollView
            android:id="@+id/settings_entries_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingLeft="@dimen/settings_zoom_room_horizontal"
                android:paddingTop="@dimen/settings_zoom_room_vertical"
                android:paddingRight="@dimen/settings_zoom_room_horizontal"
                android:paddingBottom="@dimen/settings_zoom_room_vertical" />
        </com.luncher.launcher.ui.LookAheadScrollView>
    </com.luncher.launcher.ui.ScrollFrame>
</LinearLayout>
