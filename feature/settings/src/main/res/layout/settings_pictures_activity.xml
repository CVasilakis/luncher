<?xml version="1.0" encoding="utf-8"?>
<!-- Pictures: the title and what the library holds, then the grid of thumbnails ending in the Add
     from folder tile, and Delete unused below it; or, while the library is empty, how to add a
     picture. It all scrolls together as the focus moves, so a short screen shows as much as it
     can. Mirrored in a right-to-left language, like the settings panels; the pictures aren't. -->
<!-- Its scrollbar in the overscan margin, beside the content rather than over it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_pictures_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/settings_pictures_scrollbar_inset"
    android:layout_marginRight="@dimen/settings_pictures_scrollbar_inset"
    android:clipToPadding="false"
    android:paddingTop="@dimen/settings_pictures_margin_vertical"
    android:paddingBottom="@dimen/settings_pictures_margin_vertical"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/settings_pictures_content_inset"
        android:paddingRight="@dimen/settings_pictures_content_inset">

        <TextView
            android:id="@+id/settings_pictures_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/settings_pictures_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_pictures_title_text" />

        <!-- How many pictures, how much room they take; or that one is being added. -->
        <TextView
            android:id="@+id/settings_pictures_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_pictures_tile_text_gap"
            android:layout_marginBottom="@dimen/settings_pictures_title_gap"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/settings_pictures_status_text" />

        <!-- A row of tiles (pictures_tile) for as many pictures as fit the width, the last one
             ending in the Add from folder tile (pictures_add_tile): PicturesActivity adds them. -->
        <LinearLayout
            android:id="@+id/settings_pictures_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- While the library is empty: how to add a picture, and the way to the drop folders. -->
        <LinearLayout
            android:id="@+id/settings_pictures_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_pictures_how"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/settings_pictures_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_pictures_tile_text_gap"
                android:text="@string/settings_pictures_how_share"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/settings_pictures_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_pictures_tile_text_gap"
                android:text="@string/settings_pictures_how_folder"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/settings_pictures_text" />

            <!-- The drop folder's path: left to right in every language. -->
            <TextView
                android:id="@+id/settings_pictures_empty_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_pictures_tile_text_gap"
                android:paddingStart="@dimen/settings_pictures_tile_gap"
                android:paddingEnd="0dp"
                android:textColor="@color/accent"
                android:textDirection="ltr"
                android:textSize="@dimen/settings_pictures_text" />

            <TextView
                android:id="@+id/settings_pictures_empty_add"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/settings_pictures_entry_height"
                android:layout_marginTop="@dimen/settings_pictures_title_gap"
                android:background="@drawable/entry_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/settings_pictures_entry_padding"
                android:paddingRight="@dimen/settings_pictures_entry_padding"
                android:singleLine="true"
                android:text="@string/settings_pictures_add_from_folder"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/settings_pictures_text" />
        </LinearLayout>

        <!-- Deletes every picture nothing uses, after a confirmation; there only while one is. -->
        <TextView
            android:id="@+id/settings_pictures_delete_unused"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/settings_pictures_entry_height"
            android:layout_marginTop="@dimen/settings_pictures_title_gap"
            android:background="@drawable/entry_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/settings_pictures_entry_padding"
            android:paddingRight="@dimen/settings_pictures_entry_padding"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/settings_pictures_text"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
