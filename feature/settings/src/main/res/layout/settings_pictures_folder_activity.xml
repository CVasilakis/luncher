<?xml version="1.0" encoding="utf-8"?>
<!-- Add from folder: the title and where the pictures are, then the list of them, and beside it a
     preview of the selected one, Add all and what OK does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/settings_pictures_margin_horizontal"
    android:paddingTop="@dimen/settings_pictures_margin_vertical"
    android:paddingRight="@dimen/settings_pictures_margin_horizontal"
    android:paddingBottom="@dimen/settings_pictures_margin_vertical">

    <TextView
        android:id="@+id/settings_pictures_folder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/settings_pictures_add_from_folder"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_pictures_title_text" />

    <TextView
        android:id="@+id/settings_pictures_folder_where"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_pictures_tile_text_gap"
        android:layout_marginBottom="@dimen/settings_pictures_title_gap"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/settings_pictures_status_text" />

    <!-- The list, and the preview's column at its end. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/settings_pictures_side_width">

            <!-- A pictures_folder_row per picture; selected, framed like a focused entry. -->
            <ListView
                android:id="@+id/settings_pictures_folder_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:listSelector="@drawable/entry_background"
                android:scrollbarStyle="outsideOverlay" />

            <!-- Looking for them, or none there. -->
            <TextView
                android:id="@+id/settings_pictures_folder_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/settings_pictures_text" />
        </FrameLayout>

        <!-- The preview at most this size, smaller on a short screen, so Add all and the note fit
             below it; on the smallest screens the column scrolls (PreviewColumn). -->
        <com.luncher.launcher.settings.PreviewColumn
            android:id="@+id/settings_pictures_folder_side"
            android:layout_width="@dimen/settings_pictures_preview_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Drawn at exactly its size, as the picture fills the TV's screen; PreviewColumn sets
                     it. A spinning wheel in its middle while it's drawn; a warning mark there when
                     there's none to draw (a picture this TV can't show, too large, or damaged). -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp">

                    <ImageView
                        android:id="@+id/settings_pictures_folder_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/settings_pictures_thumbnail_background"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />

                    <ProgressBar
                        android:id="@+id/settings_pictures_folder_loading"
                        android:layout_width="@dimen/settings_received_spinner"
                        android:layout_height="@dimen/settings_received_spinner"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/accent"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/settings_pictures_folder_no_preview"
                        android:layout_width="@dimen/settings_pictures_warning"
                        android:layout_height="@dimen/settings_pictures_warning"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/settings_pictures_warning"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Adds every picture of the list that can be added; dimmed, and passed by, when none can. -->
                <TextView
                    android:id="@+id/settings_pictures_folder_add_all"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_pictures_entry_height"
                    android:layout_marginTop="@dimen/settings_pictures_tile_text_gap"
                    android:background="@drawable/entry_background"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/settings_pictures_entry_padding"
                    android:paddingRight="@dimen/settings_pictures_entry_padding"
                    android:singleLine="true"
                    android:text="@string/settings_pictures_folder_add_all"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/settings_pictures_text" />

                <TextView
                    android:id="@+id/settings_pictures_folder_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/settings_pictures_tile_text_gap"
                    android:text="@string/settings_pictures_folder_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/settings_pictures_small_text" />
            </LinearLayout>
        </com.luncher.launcher.settings.PreviewColumn>
    </FrameLayout>
</LinearLayout>
