<?xml version="1.0" encoding="utf-8"?>
<!-- A group of the appearance editor edited in a screen of its own (the background): named like a
     group, its picture's name beside it; OK opens that screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/entry_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_entry_height"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/settings_entry_padding"
    android:paddingRight="@dimen/settings_entry_padding">

    <TextView
        android:id="@+id/settings_apart_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_entry_text" />

    <!-- The picture's name, the user's, which may end in "…". -->
    <TextView
        android:id="@+id/settings_apart_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_appearance_value_gap"
        android:layout_marginEnd="@dimen/settings_appearance_value_gap"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAlignment="viewEnd"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/settings_entry_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_appearance_arrow_next"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_entry_text" />
</LinearLayout>
