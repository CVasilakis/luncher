<?xml version="1.0" encoding="utf-8"?>
<!-- A picture in the grid: its thumbnail, framed while the tile has the focus, its name (which
     may end in "…", it's the user's), and what it's used for (on two lines if large text needs
     them). OK on it opens its actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/settings_pictures_tile_width"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- The frame is the foreground, over the thumbnail; it follows the tile's focused state. -->
    <FrameLayout
        android:layout_width="@dimen/settings_pictures_tile_width"
        android:layout_height="@dimen/settings_pictures_tile_height"
        android:duplicateParentState="true"
        android:foreground="@drawable/settings_pictures_tile_frame">

        <!-- The bitmap is drawn at exactly this size; its corners are rounded by its outline. -->
        <ImageView
            android:id="@+id/settings_pictures_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/settings_pictures_thumbnail_background"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </FrameLayout>

    <TextView
        android:id="@+id/settings_pictures_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_pictures_tile_text_gap"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_pictures_text" />

    <TextView
        android:id="@+id/settings_pictures_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/settings_pictures_small_text" />
</LinearLayout>
