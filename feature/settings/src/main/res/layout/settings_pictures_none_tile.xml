<?xml version="1.0" encoding="utf-8"?>
<!-- Choosing a picture, the grid's first tile: OK chooses none (no wallpaper). Drawn like the Add
     from folder tile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/settings_pictures_tile_width"
    android:layout_height="@dimen/settings_pictures_tile_height"
    android:background="@drawable/settings_pictures_add_tile"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/settings_pictures_entry_padding"
    android:paddingRight="@dimen/settings_pictures_entry_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="@string/settings_pictures_no_picture"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_pictures_text" />
</LinearLayout>
