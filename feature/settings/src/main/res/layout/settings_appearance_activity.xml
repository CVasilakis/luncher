<?xml version="1.0" encoding="utf-8"?>
<!-- The appearance editor: the title and the preview at the start, the options at the end, level
     with the title (AppearanceEditorLayout). Mirrored in a right-to-left language, like the other
     settings panels; the preview's content isn't. -->
<com.luncher.launcher.settings.AppearanceEditorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- The title right above the preview, the two centered in the height. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/settings_appearance_margin_horizontal"
        android:layout_marginTop="@dimen/settings_appearance_margin_vertical"
        android:layout_marginEnd="@dimen/settings_panel_padding"
        android:layout_marginBottom="@dimen/settings_appearance_margin_vertical"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settings_appearance_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/settings_title_gap"
            android:includeFontPadding="false"
            android:text="@string/settings_appearance"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_appearance_title_text" />

        <!-- As tall as its screen, of the TV's shape, at most the rest of the height. Not focusable: only the
             options are. -->
        <com.luncher.launcher.settings.AppearancePreviewView
            android:id="@+id/settings_appearance_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- AppearanceActivity sets the width: settings_appearance_options_width, or half the screen.
         Scrolls when the options are taller than the screen; moving the focus scrolls it. Its top
         padding is where the title is, set by AppearanceEditorLayout. The
         overscan margin at the end only: the preview's margin is at the start (and lint's
         RtlSymmetry wants both sides set). -->
    <ScrollView
        android:id="@+id/settings_appearance_scroll"
        android:layout_width="@dimen/settings_appearance_options_width"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="0dp"
        android:paddingTop="@dimen/settings_appearance_margin_vertical"
        android:paddingEnd="@dimen/settings_appearance_margin_horizontal"
        android:paddingBottom="@dimen/settings_appearance_margin_vertical"
        android:scrollbarStyle="outsideOverlay">

        <!-- AppearanceActivity adds each group, its options below it, then the reset entry. -->
        <LinearLayout
            android:id="@+id/settings_appearance_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</com.luncher.launcher.settings.AppearanceEditorLayout>
