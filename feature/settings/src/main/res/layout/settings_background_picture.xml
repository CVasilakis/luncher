<?xml version="1.0" encoding="utf-8"?>
<!-- A picture to choose in the background editor: its thumbnail, its name, on two lines at most
     (Add from folder needs both on the smallest screens), and a check while it's the draft's; it's
     activated then, tinted with the accent. Also No picture (the plain background as its
     thumbnail) and Add from folder (a plus in place of the thumbnail). -->
<com.luncher.launcher.ui.ListEntry xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/settings_entry_padding"
    android:paddingTop="@dimen/settings_background_row_padding"
    android:paddingRight="@dimen/settings_entry_padding"
    android:paddingBottom="@dimen/settings_background_row_padding">

    <ImageView
        android:id="@+id/settings_background_thumbnail"
        android:layout_width="@dimen/settings_background_thumbnail_width"
        android:layout_height="@dimen/settings_background_thumbnail_height"
        android:background="@drawable/settings_pictures_thumbnail_background"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <com.luncher.launcher.ui.ThemedText
        android:id="@+id/settings_background_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_entry_icon_gap"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="@dimen/text_entry" />

    <com.luncher.launcher.ui.ThemedIcon
        android:id="@+id/settings_background_chosen"
        android:layout_width="@dimen/icon"
        android:layout_height="@dimen/icon"
        android:layout_marginStart="@dimen/settings_appearance_value_gap"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/icon_check"
        android:visibility="gone"
        app:colorRole="primary" />
</com.luncher.launcher.ui.ListEntry>
