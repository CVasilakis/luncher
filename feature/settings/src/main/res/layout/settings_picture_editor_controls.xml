<?xml version="1.0" encoding="utf-8"?>
<!-- Below a picture editor's preview, in its start column (PictureStartColumn): the options, a grid
     of fields; Save and Delete all follow below what scrolls (settings_picture_editor_buttons).
     The background editor's and the tile banner picker's. Merged into the column's content, so
     it adds no view of its own. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The screen's options, two fields a row (OptionGrid). -->
    <LinearLayout
        android:id="@+id/settings_picture_editor_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_screen_gap"
        android:clipChildren="false"
        android:orientation="vertical" />
</merge>
