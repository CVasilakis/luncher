<?xml version="1.0" encoding="utf-8"?>
<!-- A picture editor's end column (LibraryList): below their label and, at its end, the hint that a
     long press of OK renames or deletes a picture, the library's pictures to choose from, in their
     container. LibraryList sets the width: settings_appearance_options_width, or half the screen.
     The overscan margin at the end only (lint's RtlSymmetry wants both sides set). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_pictures_column"
    android:layout_width="@dimen/settings_appearance_options_width"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="@dimen/settings_appearance_margin_vertical"
    android:paddingEnd="@dimen/settings_appearance_margin_horizontal"
    android:paddingBottom="@dimen/settings_appearance_margin_vertical">

    <!-- The label, and at its end how to rename or delete a picture. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_label_gap"
        android:gravity="bottom"
        android:orientation="horizontal">

        <com.luncher.launcher.ui.ThemedText
            style="@style/Widget.Luncher.Settings.Label"
            android:layout_marginStart="@dimen/settings_container_padding"
            android:layout_marginBottom="0dp"
            android:text="@string/settings_background_pictures" />

        <com.luncher.launcher.ui.ThemedText
            android:id="@+id/settings_pictures_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/settings_appearance_value_gap"
            android:layout_marginEnd="@dimen/settings_container_padding"
            android:layout_weight="1"
            android:text="@string/settings_background_hint"
            android:textAlignment="viewEnd"
            android:textSize="@dimen/text_supporting"
            app:colorRole="onSurfaceVariant" />
    </LinearLayout>

    <!-- As tall as the pictures, at most what the column leaves; they scroll there, a row
         ahead of the focus, cut along the container's corners, fading out where there's more.
         Down past the last picture stays there, not to Save or Delete all. -->
    <com.luncher.launcher.settings.ListFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fill="surface">

        <com.luncher.launcher.ui.LookAheadScrollView
            android:id="@+id/settings_pictures_list_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <!-- The first row (the screen names it: No picture), the library's pictures, Add
                 from folder; while the library is empty, how to add a picture. LibraryList adds
                 them. A margin inside around them, which their corners follow. -->
            <LinearLayout
                android:id="@+id/settings_pictures_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="@dimen/settings_container_padding" />
        </com.luncher.launcher.ui.LookAheadScrollView>
    </com.luncher.launcher.settings.ListFrame>
</LinearLayout>
