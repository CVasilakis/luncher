<?xml version="1.0" encoding="utf-8"?>
<!-- The background editor: at the start the preview, with no label above it, so it's larger, the
     background's options in a 2 x 2 grid of fields, Save and Delete all, which scroll on the
     smallest screens; at the end, below their label and the hint, the pictures to choose from in
     their container.
     Mirrored in a right-to-left language, like the other settings screens; the preview's content
     isn't. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:clipChildren="false"
    android:orientation="horizontal">

    <!-- The overscan margin at the start, less the room the content keeps for a focused entry's
         zoom; the gap to the pictures at the end. The preview as tall as the room left
         (PictureStartColumn); on the smallest screens, moving the focus scrolls it. It cuts
         its content neither at its padding nor at the content's edges, which end at Save and
         Delete all: their zoom and shadow reach past them. -->
    <com.luncher.launcher.settings.PictureStartColumn
        android:id="@+id/settings_background_start"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/settings_screen_margin_less_room"
        android:paddingTop="@dimen/settings_appearance_margin_vertical"
        android:paddingEnd="@dimen/settings_screen_gap_less_room"
        android:paddingBottom="@dimen/settings_appearance_margin_vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="@dimen/settings_container_padding"
            android:paddingRight="@dimen/settings_container_padding">

            <!-- The home screen with the draft's background, its size set by
                 PictureStartColumn, its corners rounded. Not focusable. -->
            <com.luncher.launcher.settings.AppearancePreviewView
                android:id="@+id/settings_background_preview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal" />

            <!-- The options, Save and Delete all. -->
            <include layout="@layout/settings_picture_editor_controls" />
        </LinearLayout>
    </com.luncher.launcher.settings.PictureStartColumn>

    <!-- The pictures to choose from. -->
    <include layout="@layout/settings_pictures_column" />
</LinearLayout>
