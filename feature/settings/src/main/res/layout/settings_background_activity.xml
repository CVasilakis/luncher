<?xml version="1.0" encoding="utf-8"?>
<!-- The background editor: at the start the preview, the background's options, Save and Delete
     all, which scroll on the smallest screens; no title, so the preview gets its room. At the end the
     pictures to choose from, a hint above them. Mirrored in a right-to-left language, like the
     other settings screens; the preview's content isn't. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- The overscan margin at the start, the gap to the pictures at the end. The preview as tall
         as the room left (BackgroundStartColumn); on the smallest screens, moving the focus scrolls
         it. -->
    <com.luncher.launcher.settings.BackgroundStartColumn
        android:id="@+id/settings_background_start"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/settings_appearance_margin_horizontal"
        android:paddingTop="@dimen/settings_appearance_margin_vertical"
        android:paddingEnd="@dimen/settings_panel_padding"
        android:paddingBottom="@dimen/settings_appearance_margin_vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- The home screen with the draft's background, its height set by
                 BackgroundStartColumn. Not focusable. -->
            <com.luncher.launcher.settings.AppearancePreviewView
                android:id="@+id/settings_background_preview"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <!-- BackgroundActivity adds the background's options. -->
            <LinearLayout
                android:id="@+id/settings_background_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_title_gap"
                android:orientation="vertical" />

            <!-- Save at the start, Delete all at the end, half the row each; one below the other
                 when either doesn't fit its half (EntriesRow). -->
            <com.luncher.launcher.settings.EntriesRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/settings_background_save"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_entry_height"
                    android:layout_weight="1"
                    android:background="@drawable/entry_background"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/settings_entry_padding"
                    android:paddingRight="@dimen/settings_entry_padding"
                    android:singleLine="true"
                    android:text="@string/settings_background_save"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/settings_entry_text" />

                <!-- In red: it deletes every picture. Dimmed, and passed by, while there's none. -->
                <TextView
                    android:id="@+id/settings_background_delete_all"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_entry_height"
                    android:layout_weight="1"
                    android:background="@drawable/entry_background"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/settings_entry_padding"
                    android:paddingRight="@dimen/settings_entry_padding"
                    android:singleLine="true"
                    android:text="@string/settings_background_delete_all"
                    android:textColor="@color/settings_delete"
                    android:textSize="@dimen/settings_entry_text" />
            </com.luncher.launcher.settings.EntriesRow>
        </LinearLayout>
    </com.luncher.launcher.settings.BackgroundStartColumn>

    <!-- BackgroundActivity sets the width: settings_appearance_options_width, or half the screen.
         The overscan margin at the end only (lint's RtlSymmetry wants both sides set). -->
    <LinearLayout
        android:id="@+id/settings_background_end"
        android:layout_width="@dimen/settings_appearance_options_width"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="@dimen/settings_appearance_margin_vertical"
        android:paddingEnd="@dimen/settings_appearance_margin_horizontal"
        android:paddingBottom="@dimen/settings_appearance_margin_vertical">

        <!-- How to rename or delete a picture, at the top, as arrange mode's hint. -->
        <TextView
            android:id="@+id/settings_background_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_background_hint"
            android:paddingLeft="@dimen/settings_entry_padding"
            android:paddingRight="@dimen/settings_entry_padding"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/settings_pictures_small_text" />

        <ScrollView
            android:id="@+id/settings_background_list_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/settings_title_gap"
            android:layout_weight="1"
            android:scrollbarStyle="outsideOverlay">

            <!-- No picture, the library's pictures, Add from folder; while the library is empty,
                 how to add a picture. BackgroundActivity adds them. -->
            <LinearLayout
                android:id="@+id/settings_background_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
