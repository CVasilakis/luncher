<?xml version="1.0" encoding="utf-8"?>
<!-- The grid's last tile, where a picture would be: OK opens Add from folder. Its name may take
     three lines, in a longer language with large text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/settings_pictures_tile_width"
    android:layout_height="@dimen/settings_pictures_tile_height"
    android:background="@drawable/settings_pictures_add_tile"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/settings_pictures_entry_padding"
    android:paddingRight="@dimen/settings_pictures_entry_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/settings_pictures_tile_text_gap"
        android:text="@string/settings_pictures_plus"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_pictures_text" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="@string/settings_pictures_add_from_folder"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_pictures_text" />
</LinearLayout>
