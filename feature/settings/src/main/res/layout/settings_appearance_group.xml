<?xml version="1.0" encoding="utf-8"?>
<!-- A group of options in the appearance editor, named after the part of the home screen they
     change, or the theme, its icon before it: OK shows its options below it, or hides them again.
     Its mark points down while they're hidden, up while they show. -->
<com.luncher.launcher.ui.ListEntry xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_height"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/settings_entry_padding"
    android:paddingTop="@dimen/settings_entry_padding_vertical"
    android:paddingRight="@dimen/settings_entry_padding"
    android:paddingBottom="@dimen/settings_entry_padding_vertical">

    <com.luncher.launcher.ui.ThemedIcon
        android:id="@+id/settings_group_icon"
        android:layout_width="@dimen/icon"
        android:layout_height="@dimen/icon"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        app:colorRole="onSurfaceVariant" />

    <com.luncher.launcher.ui.ThemedText
        android:id="@+id/settings_group_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_entry_icon_gap"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="@dimen/text_entry" />

    <com.luncher.launcher.ui.ThemedIcon
        android:id="@+id/settings_group_arrow"
        android:layout_width="@dimen/icon"
        android:layout_height="@dimen/icon"
        android:layout_marginStart="@dimen/settings_appearance_value_gap"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/icon_caret_down"
        app:colorRole="onSurfaceVariant" />
</com.luncher.launcher.ui.ListEntry>
