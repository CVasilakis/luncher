<?xml version="1.0" encoding="utf-8"?>
<!-- A picture editor's Save at the start, Delete all at the end, half the row each; one below the
     other when either doesn't fit its half (EntriesRow). In its start column, below what scrolls
     (PictureStartColumn): right below the options, or at the bottom where they don't all fit.
     Inset by the room for its zoom at the sides, as the column's content is. -->
<com.luncher.launcher.ui.EntriesRow xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/settings_container_padding"
    android:layout_marginTop="@dimen/settings_screen_gap"
    android:layout_marginRight="@dimen/settings_container_padding"
    android:baselineAligned="false"
    android:clipChildren="false"
    android:orientation="horizontal">

    <com.luncher.launcher.ui.PillButton
        android:id="@+id/settings_picture_editor_save"
        style="@style/Widget.Luncher.Button"
        android:drawableStart="@drawable/icon_check"
        android:text="@string/settings_picture_editor_save" />

    <!-- In the error color: it deletes every picture. Dimmed, and passed by, while there's none. -->
    <com.luncher.launcher.ui.PillButton
        android:id="@+id/settings_picture_editor_delete_all"
        style="@style/Widget.Luncher.Button"
        android:drawableStart="@drawable/icon_trash"
        android:text="@string/settings_picture_editor_delete_all"
        app:kind="danger" />
</com.luncher.launcher.ui.EntriesRow>
