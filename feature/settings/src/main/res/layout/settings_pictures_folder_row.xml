<?xml version="1.0" encoding="utf-8"?>
<!-- A picture of the drop folders: a USB drive or the TV, where it is, then its name, below it
     where it is again in words and its size, and below that, on a line of its own, why it can't be
     added, in the error color. Every line one line, cut with "…" where it must; while a picture of
     the list can't be added, every row is as tall as three lines, its lines centered in it
     (AddFromFolderActivity). Not focusable: the list moves its selection; the selected row looks
     focused. -->
<com.luncher.launcher.ui.ListEntry xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_pictures_row_height"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/entry_padding"
    android:paddingTop="@dimen/settings_entry_padding_vertical"
    android:paddingRight="@dimen/entry_padding"
    android:paddingBottom="@dimen/settings_entry_padding_vertical"
    app:entryCorner="@dimen/corner_entry_in_container">

    <com.luncher.launcher.ui.ThemedIcon
        android:id="@+id/settings_pictures_folder_where_icon"
        android:layout_width="@dimen/icon"
        android:layout_height="@dimen/icon"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        app:colorRole="onSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/entry_icon_gap"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <com.luncher.launcher.ui.ThemedText
            android:id="@+id/settings_pictures_folder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="@dimen/text_entry" />

        <com.luncher.launcher.ui.ThemedText
            android:id="@+id/settings_pictures_folder_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_entry_line_gap"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="@dimen/text_supporting"
            app:colorRole="onSurfaceVariant" />

        <com.luncher.launcher.ui.ThemedText
            android:id="@+id/settings_pictures_folder_why"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_entry_line_gap"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="@dimen/text_supporting"
            android:visibility="gone"
            app:colorRole="error" />
    </LinearLayout>
</com.luncher.launcher.ui.ListEntry>
