<?xml version="1.0" encoding="utf-8"?>
<!-- Over a grid tile's thumbnail: framed in the accent color while the tile has the focus, as a
     focused tile of the home screen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <stroke
                android:width="@dimen/settings_pictures_frame"
                android:color="@color/accent" />
            <corners android:radius="@dimen/settings_pictures_tile_corner" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
