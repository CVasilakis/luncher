<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen from API 23 on: the drawing at its own size, 960x540 dp, in the middle of
     the home screen's background, so it keeps its shape on any screen. A 16:9 TV is usually
     960x540 dp, which it fills; on others the glow's edge fades into the background around it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/background" />
    <item android:drawable="@drawable/launch_screen_art" android:gravity="center"
        android:width="960dp" android:height="540dp" />
</layer-list>
